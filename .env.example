# 复制为 .env 后填入真实值：cp .env.example .env
PROVIDERS=P1, P2
DEFAULT_PROVIDER=P1

# P1 (Chat Completions)
P1_API_KEY=YOUR-APIKEY
P1_BASE_URL=https://your.base.url/v1
P1_MODEL=YOUR-MODEL
P1_REASONING_LEVELS=low,high,max
P1_CONTEXT_WINDOW=1000000
P1_API=chat  # Chat Completions 需要
P1_INPUT_PRICE=0.15
P1_OUTPUT_PRICE=0.50
P1_CACHE_READ_PRICE=0.03

# P2 (OpenAI Responses)
P2_API_KEY=YOUR-APIKEY
P2_BASE_URL=https://your.base.url/v1
P2_MODEL=YOUR-MODEL
P2_REASONING_LEVELS=low,medium,xhigh
P2_CONTEXT_WINDOW=262144
P2_API=responses  # OpenAI Responses（默认，可省略）
P2_INPUT_PRICE=0
P2_OUTPUT_PRICE=0
P2_CACHE_READ_PRICE=0
P2_CACHE_WRITE_PRICE=0

REASONING_EFFORT=low
